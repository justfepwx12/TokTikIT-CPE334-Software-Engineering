generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Lab 3 — Issue 3 Category list (read-only reference data; seeded only).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Lab 2 Issue 41 — Systems a ticket can be related to (read-only, seeded only).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Lab 3 §9.1 — every authenticated person. Lab 2 Requester rows migrate here
// with role REQUESTER (AD-04). IT Staff and Administrators are seeded too.
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  // BR-03/AD-09: migrated users + newly created users must change their
  // initial password at first login; seeded demo accounts may be false.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownedTickets   Ticket[]       @relation("Owner")
  requesterGroup Ticket[]       @relation("Requester")
  comments       Comment[]
  internalNotes  InternalNote[]

  @@index([role])
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMIN
}

// Lab 3 §9.1 — eight-status lifecycle (AD-03). NEW replaces Lab 2 PENDING.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Lab 3 §9.1 — the core IT ticket. The old single `priority` splits into
// requestedPriority (set by the Requester at creation) and itPriority
// (initialized as a copy, changeable only by IT Staff/Admin — BR-14).
model Ticket {
  id Int @id @default(autoincrement())

  // BR-01: format TK-YYYYMMDD-XXXX, backend-generated, unique.
  ticketNo String @unique

  title       String
  description String

  requestedPriority TicketPriority
  itPriority        TicketPriority

  // Lab 2 visible-to-all statuses existed for forward-compat only; Lab 3
  // implements the full transition matrix (AD-03).
  status TicketStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requesterId Int
  requester   User @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)

  // BR-13: at most one primary Owner (active IT Staff/Admin); unassigned
  // initially. Nullable — migrated Lab 2 tickets have no owner (AD-04).
  ownerId Int?
  owner   User? @relation("Owner", fields: [ownerId], references: [id], onDelete: SetNull)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  systemId Int
  system   RelatedSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)

  attachments   Attachment[]
  comments      Comment[]
  internalNotes InternalNote[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([systemId])
}

// Lab 3 §9.1 — public, append-only communication (BR-17).
model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())

  // Deterministic key for idempotent seed upserts (AC-33). Nullable so
  // real user-authored comments never carry one and are never touched by
  // re-runs of prisma db seed.
  seedKey String?

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, seedKey])
  @@index([ticketId])
}

// Lab 3 §9.1 — IT Staff/Admin-only, append-only operational notes (BR-18).
model InternalNote {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())

  // Deterministic key for idempotent seed upserts (AC-33). Nullable so
  // real user-authored notes never carry one and are never touched by
  // re-runs of prisma db seed.
  seedKey String?

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, seedKey])
  @@index([ticketId])
}

// Lab 2 Issue 41 — Files attached to a ticket
model Attachment {
  id Int @id @default(autoincrement())

  // Original client-supplied filename — display metadata only, BR-20:
  // never used to build a filesystem path.
  filename String

  // BR-20: server-generated, UUID-based storage name/path. The client
  // filename never participates in path construction (blocks traversal).
  filePath String

  mimeType String
  size     Int // bytes — enforced against BR-07 (5 MB max) at the API layer

  // BR-08: soft removal only, never hard-deleted.
  // removalReason is nullable at the DB level (no value until removed);
  // the API layer must enforce 3-200 chars, required when isRemoved=true.
  isRemoved     Boolean   @default(false)
  removedAt     DateTime?
  removalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId])
}
